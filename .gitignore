# game_loop runtime state (dogfooded in this repo)
.game_loop/state.json
.game_loop/sessions/
.game_loop/edited.txt
.game_loop/write-guard-probe
.game_loop/log.jsonl
.game_loop/verified.json
.game_loop/probe/
.game_loop/*.pid
.game_loop/.state.*.tmp
.game_loop/notify.json
.game_loop/limits.json
.game_loop/.limits.*.tmp
.game_loop/.limits.lock
.game_loop/HANDOFF.md
.game_loop/.update_cache.json
.game_loop/upstream.json
.game_loop/config.local.json
.game_loop/triggers.json
.game_loop/triggers.d/

# pinned harness checkout (`game_loop self --pin <ref>`) — CODE only, at a chosen commit, so the
# hooks guarding a session are not the same files that session is editing. Local by construction:
# which commit you pin is a machine-local decision, and the hooks that point at it belong in
# .claude/settings.local.json (also gitignored), never in the tracked .claude/settings.json.
.game_loop_self/

# python
__pycache__/
*.pyc

# session handoff (local only)
NEXT_SESSION.md
.claude/handoff/

# macOS
.DS_Store

# showrunner: per-Crawler git worktrees (local only)
.worktrees/

# machine-local hook config (absolute paths)
.claude/settings.local.json

# llm_chat identity for this project
.llm_chat/
.game_loop/UPSTREAM_LEDGER.md

# Added by saggar — local files that shouldn't be committed
.saggar/**/*.local.*
.saggar/scratchpad.md
.saggar/jobs/
